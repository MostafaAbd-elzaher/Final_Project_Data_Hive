# Dockerfile for IoT Producer Service
FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update --fix-missing && apt-get install -y \
    gcc \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file
COPY requirements.txt .

# Install Python dependencies for Producer (kafka-python, influxdb-client)
RUN pip install --no-cache-dir kafka-python influxdb-client

# Copy Producer code
COPY Producer/ ./Producer/

# Copy entrypoint script
COPY docker-entrypoint-producer.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create directory for output data
RUN mkdir -p /app/data

# Environment variables
ENV KAFKA_BOOTSTRAP_SERVERS=kafka:29092
ENV OUTPUT_DIR=/app/data
ENV PYTHONUNBUFFERED=1

# Run entrypoint script
ENTRYPOINT ["/entrypoint.sh"]
