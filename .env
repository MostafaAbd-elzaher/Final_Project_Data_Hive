# Environment variables for Docker Compose
# All services will use these configurations

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=farm_dwh
POSTGRES_USER=spark_user
POSTGRES_PASSWORD=spark_password

# Producer Configuration
OUTPUT_DIR=/root/spark_project_data/output

# Spark Configuration (for Linux)
SPARK_HOME=/opt/spark
HOME=/root
PARQUET_BASE_PATH=/root/spark_project_data/farm_iot_parquet
CHECKPOINT_BASE=/root/spark_project_data/checkpoints/farm_iot_full_pipeline

# InfluxDB Configuration
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=my_super_secret_token
INFLUX_ORG=my_org
INFLUX_BUCKET=iot_bucket
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=my_user
DOCKER_INFLUXDB_INIT_PASSWORD=my_password
DOCKER_INFLUXDB_INIT_ORG=my_org
DOCKER_INFLUXDB_INIT_BUCKET=iot_bucket
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=my_super_secret_token

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
